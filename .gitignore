# Build output and large binaries
target/
*.iso
evidence/iso/
evidence/tmp/

# Stale / generated artifacts (not source)
/iso/
*.orig
*.lst
# Stray numbered files from an accidental shell redirect
/axiom-x-capability/src/[0-9]*
# Ledger disk images written by qemu-boot.sh
evidence/*.img
# Ledger signing seeds (secret)
*.key
# Hyper-V test VM files (VHD copy of the ledger, VM config)
evidence/hyperv/
# backups hyperv-run.ps1 -UseLedger keeps of the disk images
evidence/*.before-hyperv
